{
  "name": "@open2bill/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open2Bill: fatturazione elettronica FatturaPA (app desktop)",
  "author": "Open Edge Lab",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsup",
    "start": "tsup && electron .",
    "dist": "tsup && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.0",
    "handlebars": "^4.7.10",
    "xmlbuilder2": "^4.0.0",
    "xmllint-wasm": "^5.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@open2bill/core": "*",
    "@open2bill/server": "*",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "tsup": "^9.0.0"
  },
  "build": {
    "appId": "lab.openedge.open2bill",
    "productName": "Open2Bill",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../web/dist", "to": "web" },
      { "from": "../server/assets", "to": "assets" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Open2Bill"
    }
  }
}
